open CategoryTheory CategoryTheory.Limits AlgebraicGeometry FormalSpectrum TopologicalSpace
open Opposite

universe v u w

namespace CategoryTheory

variable {G : Type v} [Group G] {W P : AlgebraicGeometry.LocallyRingedSpace.{u}}
variable {a : G →* Aut W} {π : W ⟶ P}
variable [Limits.HasCoproduct fun _ : G => W]
  [Limits.HasCoequalizer (actionQuotientLeft a) (actionQuotientRight G W)]

/-- **The global-sections homomorphism of a descent is pinned by the one it descends.** If the
invariant `k : W ⟶ Spf S` induces `u` on global sections after pullback along the projection, then
its mediating morphism induces `u` itself.

`FormalSpectrum.globalSectionsHom_comp` gives the factorisation and
`CategoryTheory.IsActionQuotient.injective_c_app` cancels the projection, which is the whole proof:
a section of a quotient is determined by its pullback. It is what turns a computation of the
sections of a morphism *out of the source* into one about the descended morphism, where the source
is the quotient and nothing is directly computable. -/
theorem IsActionQuotient.globalSectionsHom_desc_eq {S : Type u} [CommRing S] [TopologicalSpace S]
    (J : Ideal S) [IsAdicRing J] (h : IsActionQuotient a π)
    (k : W ⟶ FormalSpectrum.locallyRingedSpaceObj J) (hk : IsActionInvariant a k)
    (u : S →+* P.presheaf.obj (op (⊤ : Opens P)))
    (hu : FormalSpectrum.globalSectionsHom J W k = (π.c.app (op (⊤ : Opens P))).hom.comp u) :
    FormalSpectrum.globalSectionsHom J P (h.desc k hk) = u := by
  have h1 : FormalSpectrum.globalSectionsHom J W k =
      (π.c.app (op (⊤ : Opens P))).hom.comp
        (FormalSpectrum.globalSectionsHom J P (h.desc k hk)) := by
    rw [← FormalSpectrum.globalSectionsHom_comp, h.fac k hk]
  refine RingHom.ext fun s => h.injective_c_app (⊤ : Opens P) ?_
  exact congrArg (fun φ : S →+* _ => φ s) (h1.symm.trans hu)

end CategoryTheory

namespace FormalSpectrum

variable {S : Type u} [CommRing S] [TopologicalSpace S] (J : Ideal S) [IsAdicRing J]

/-- **A bijective global-sections homomorphism inverts the comparison map at `⊤`.**
`FormalSpectrum.globalSectionsHom` is the comparison map at `⊤` precomposed with the isomorphism
`FormalSpectrum.globalSectionsEquiv`, so the two are bijective together; the direction stated is
the one a computation of the global-sections homomorphism feeds.

It is the `⊤` component of the sheaf half of an isomorphism criterion, and nothing more: it says
nothing about any proper open. -/
theorem isIso_c_app_top_of_bijective_globalSectionsHom {P : LocallyRingedSpace.{u}}
    (f : P ⟶ locallyRingedSpaceObj J) (h : Function.Bijective (globalSectionsHom J P f)) :
    IsIso (f.c.app (op (⊤ : Opens (FormalSpectrum J)))) := by
  rw [ConcreteCategory.isIso_iff_bijective]
  have he : ⇑(CommRingCat.Hom.hom (f.c.app (op (⊤ : Opens (FormalSpectrum J))))) =
      (globalSectionsHom J P f) ∘ (globalSectionsEquiv J) := by
    funext s
    rw [Function.comp_apply, globalSectionsHom_apply, (globalSectionsEquiv J).symm_apply_apply]
  rw [he]
  exact h.comp (globalSectionsEquiv J).bijective

end FormalSpectrum

namespace AlgebraicGeometry

variable (R : Type u) [CommRing R] (I : Ideal R) (q : R)
variable [TopologicalSpace R] [IsAdicRing I] [IsNoetherianRing R] (hq : q ∈ I) (hI : I.FG)

/-! ### The section map, read on the restricted projection -/

set_option linter.style.setOption false in
set_option backward.isDefEq.respectTransparency false in
/-- **The node chart's section map is the pullback along the restricted projection.**
`AlgebraicGeometry.nodeChartSectionsHom_eq` presents it as the section map of
`T_inv|_{π⁻¹ V₀} ⟶ T_inv ⟶ T_inv/⟨σ⟩`; that composite factors as
`AlgebraicGeometry.LocallyRingedSpace.restrictπ` followed by the inclusion of `V₀`
(`AlgebraicGeometry.LocallyRingedSpace.restrictOpensHom_comp_ofRestrict`), and
`AlgebraicGeometry.LocallyRingedSpace.sectionsMapOfRangeSubset_comp` splits the section map along
that factorisation. The first factor is then
`AlgebraicGeometry.LocallyRingedSpace.restrictTopSectionsIso`, by
`AlgebraicGeometry.LocallyRingedSpace.restrictTopSectionsIso_inv_eq`.

This is what lets the sections of the node chart be compared with the sections of an *open of the
quotient* rather than with the sections of the chain. -/
theorem nodeChartSectionsHom_eq_restrictπ :
    nodeChartSectionsHom R I q hq hI =
      (LocallyRingedSpace.restrictTopSectionsIso (actionQuotient (tateInvPeriodAction R I q hq hI))
        (tateInvNodeChartQuotientOpens R I q hq hI)).inv ≫
        (LocallyRingedSpace.restrictπ (actionQuotientπ (tateInvPeriodAction R I q hq hI))
          (tateInvNodeChartQuotientOpens R I q hq hI)).c.app (op ⊤) := by
  rw [nodeChartSectionsHom_eq,
    LocallyRingedSpace.sectionsMapOfRangeSubset_congr
      (LocallyRingedSpace.restrictOpensHom_comp_ofRestrict
        (actionQuotientπ (tateInvPeriodAction R I q hq hI)) _ _ _).symm _
      (LocallyRingedSpace.range_ofRestrict_comp_subset _ _),
    LocallyRingedSpace.sectionsMapOfRangeSubset_comp,
    LocallyRingedSpace.restrictTopSectionsIso_inv_eq]
  all_goals first
    | rfl
    | exact le_of_eq (LocallyRingedSpace.range_ofRestrict _ _)
    | (rw [LocallyRingedSpace.restrictOpensHom_comp_ofRestrict]
       exact LocallyRingedSpace.range_ofRestrict_comp_subset _ _)

section Instances

variable [TopologicalSpace ((actionQuotient (tateInvPeriodAction R I q hq hI)).presheaf.obj
  (op (tateInvNodeChartQuotientOpens R I q hq hI)))]
variable [IsAdicRing (tateInvNodeChartQuotientIdeal R I q hq hI)]
variable (hfgI : (tateInvNodeChartQuotientIdeal R I q hq hI).FG)
variable (hX : FormalScheme.AdicSectionsLocallyFG (tateInvNodeChartQuotientIdeal R I q hq hI)
  (nodeChartPsi R I q hq hI))

/-! ### The descent, taken along the restricted projection -/

/-- **The canonical comparison from the node chart's open of the quotient to the formal spectrum of
its sections.** `AlgebraicGeometry.nodeChartAdicHom` is invariant
(`AlgebraicGeometry.isActionInvariant_nodeChartAdicHom`) and
`AlgebraicGeometry.LocallyRingedSpace.restrictπ` is a quotient projection for the restricted action
(`AlgebraicGeometry.isActionQuotient_restrictπ_tateInvNodeChartQuotientOpens`), so it descends. The
target's ring is `Γ (T_inv/⟨σ⟩, V₀)` itself, so this is the comparison an affineness question is
asked at.

Descending along `restrictπ` rather than along the coequalizer is not a second morphism in any
sense that matters: by `CategoryTheory.IsActionQuotient.isIso_desc_iff_isIso_desc` the two are
isomorphisms together, which is `AlgebraicGeometry.isIso_desc_nodeChartAdicHom_iff`. What it buys
is that the source is an open of `T_inv/⟨σ⟩` and not a coequalizer nobody can compute in. -/
def nodeChartQuotientHom :
    (actionQuotient (tateInvPeriodAction R I q hq hI)).restrict
        (tateInvNodeChartQuotientOpens R I q hq hI).isOpenEmbedding ⟶
      locallyRingedSpaceObj (tateInvNodeChartQuotientIdeal R I q hq hI) :=
  (isActionQuotient_restrictπ_tateInvNodeChartQuotientOpens R I q hq hI).desc
    (nodeChartAdicHom R I q hq hI hfgI hX)
    (isActionInvariant_nodeChartAdicHom R I q hq hI hfgI hX)

/-- **Its defining property**: pulled back along the restricted projection it is
`AlgebraicGeometry.nodeChartAdicHom`. `CategoryTheory.IsActionQuotient.fac`, recorded because every
computation below runs through it. -/
theorem restrictπ_comp_nodeChartQuotientHom :
    LocallyRingedSpace.restrictπ (actionQuotientπ (tateInvPeriodAction R I q hq hI))
        (tateInvNodeChartQuotientOpens R I q hq hI) ≫
      nodeChartQuotientHom R I q hq hI hfgI hX = nodeChartAdicHom R I q hq hI hfgI hX :=
  (isActionQuotient_restrictπ_tateInvNodeChartQuotientOpens R I q hq hI).fac _ _

/-! ### The reductions -/

/-- **Hypothesis 4 says `AlgebraicGeometry.nodeChartAdicHom` is itself a quotient projection.**
`CategoryTheory.IsActionQuotient.isIso_desc_iff` at the node chart. The right-hand side names no
quotient object and no mediating morphism, so this is the packaging coming off: what hypothesis 4
asks is that the morphism into the formal spectrum exhibit that formal spectrum as
`T_inv|_{π⁻¹ V₀} / ⟨σ⟩`.

`Nonempty` because `CategoryTheory.IsActionQuotient` carries its mediating morphism as data. -/
theorem isIso_desc_nodeChartAdicHom_iff_isActionQuotient :
    IsIso ((isActionQuotient_actionQuotientπ (tateInvNodeChartRestrictedAction R I q hq hI)).desc
        (nodeChartAdicHom R I q hq hI hfgI hX)
        (isActionInvariant_nodeChartAdicHom R I q hq hI hfgI hX)) ↔
      Nonempty (IsActionQuotient (tateInvNodeChartRestrictedAction R I q hq hI)
        (nodeChartAdicHom R I q hq hI hfgI hX)) :=
  IsActionQuotient.isIso_desc_iff _ _ _

/-- **Hypothesis 4, at a morphism out of an open of `T_inv/⟨σ⟩`.** The descent along the
coequalizer and the descent along `AlgebraicGeometry.LocallyRingedSpace.restrictπ` are isomorphisms
together, by `CategoryTheory.IsActionQuotient.isIso_desc_iff_isIso_desc`. So hypothesis 4 is:

> the canonical comparison `(T_inv/⟨σ⟩)|_{V₀} ⟶ Spf (Γ (T_inv/⟨σ⟩, V₀))` is an isomorphism.

The right-hand side mentions neither `CategoryTheory.IsActionQuotient.desc` nor the coequalizer of
the restricted action. It does still mention `CategoryTheory.actionQuotient`, at the *period*
action — the source is an open of `T_inv/⟨σ⟩`, which is what `hnode` is about and cannot be traded
away — and it carries the `AlgebraicGeometry.FormalScheme.AdicSectionsLocallyFG` witness in its
binders. This is the form in which the residue is to be attacked. -/
theorem isIso_desc_nodeChartAdicHom_iff :
    IsIso ((isActionQuotient_actionQuotientπ (tateInvNodeChartRestrictedAction R I q hq hI)).desc
        (nodeChartAdicHom R I q hq hI hfgI hX)
        (isActionInvariant_nodeChartAdicHom R I q hq hI hfgI hX)) ↔
      IsIso (nodeChartQuotientHom R I q hq hI hfgI hX) :=
  IsActionQuotient.isIso_desc_iff_isIso_desc _
    (isActionQuotient_restrictπ_tateInvNodeChartQuotientOpens R I q hq hI) _ _

/-- **The two halves of hypothesis 4**, by
`AlgebraicGeometry.LocallyRingedSpace.isIso_iff_isIso_base_and_isIso_c_app`: the base map is a
homeomorphism, and every comparison map on sections is invertible. The equivalence is two-way, so
a refutation of either half refutes hypothesis 4 — while a refutation of hypothesis 4 refutes
neither `hnode` nor the existential form; see the module docstring.

The second conjunct is discharged at `O = op ⊤` by
`AlgebraicGeometry.isIso_c_app_top_nodeChartQuotientHom`, for a structural reason and with no
geometry. Neither the first conjunct nor the second at a proper open is decided anywhere. -/
theorem isIso_desc_nodeChartAdicHom_iff_base_and_c :
    IsIso ((isActionQuotient_actionQuotientπ (tateInvNodeChartRestrictedAction R I q hq hI)).desc
        (nodeChartAdicHom R I q hq hI hfgI hX)
        (isActionInvariant_nodeChartAdicHom R I q hq hI hfgI hX)) ↔
      IsIso (nodeChartQuotientHom R I q hq hI hfgI hX).base ∧
        ∀ O : (Opens (FormalSpectrum (tateInvNodeChartQuotientIdeal R I q hq hI)))ᵒᵖ,
          IsIso ((nodeChartQuotientHom R I q hq hI hfgI hX).c.app O) :=
  (isIso_desc_nodeChartAdicHom_iff R I q hq hI hfgI hX).trans
    (LocallyRingedSpace.isIso_iff_isIso_base_and_isIso_c_app _)

/-! ### The sheaf half at the top open -/

set_option linter.style.setOption false in
set_option backward.isDefEq.respectTransparency false in
/-- **The descent induces the canonical identification on global sections.** Both sides are ring
homomorphisms `Γ (T_inv/⟨σ⟩, V₀) →+* Γ ((T_inv/⟨σ⟩)|_{V₀}, ⊤)`; the right-hand side is the
identification of `AlgebraicGeometry.LocallyRingedSpace.restrictTopSectionsIso`, which is an
isomorphism.

`CategoryTheory.IsActionQuotient.globalSectionsHom_desc_eq` reduces this to the same statement one
level down, at `AlgebraicGeometry.nodeChartAdicHom`, where it is
`AlgebraicGeometry.globalSectionsHom_nodeChartAdicHom` followed by
`AlgebraicGeometry.nodeChartSectionsHom_eq_restrictπ`. -/
theorem globalSectionsHom_nodeChartQuotientHom :
    globalSectionsHom (tateInvNodeChartQuotientIdeal R I q hq hI) _
        (nodeChartQuotientHom R I q hq hI hfgI hX) =
      (LocallyRingedSpace.restrictTopSectionsIso
        (actionQuotient (tateInvPeriodAction R I q hq hI))
        (tateInvNodeChartQuotientOpens R I q hq hI)).inv.hom := by
  refine (isActionQuotient_restrictπ_tateInvNodeChartQuotientOpens R I q hq
    hI).globalSectionsHom_desc_eq _ _ _ _ ?_
  refine (globalSectionsHom_nodeChartAdicHom R I q hq hI hfgI hX).trans ?_
  rw [show nodeChartPsi R I q hq hI = (nodeChartSectionsHom R I q hq hI).hom from rfl,
    nodeChartSectionsHom_eq_restrictπ, CommRingCat.hom_comp]

/-- **The sheaf half of hypothesis 4 holds at `⊤`.** The comparison map of
`AlgebraicGeometry.nodeChartQuotientHom` at the top open is an isomorphism, with no hypothesis
beyond the ones already standing.

**It is not evidence for hypothesis 4.** The morphism is built from
`AlgebraicGeometry.nodeChartPsi`, which *is* the identification of `Γ (T_inv/⟨σ⟩, V₀)` with the
invariant sections, so the computation of
`AlgebraicGeometry.globalSectionsHom_nodeChartQuotientHom` uses no property of the node locus, the
annulus algebras or the `σ`-action. What it establishes is where hypothesis 4's content is not:
neither at the top open, nor in any general fact about descents. -/
theorem isIso_c_app_top_nodeChartQuotientHom :
    IsIso ((nodeChartQuotientHom R I q hq hI hfgI hX).c.app
      (op (⊤ : Opens (FormalSpectrum (tateInvNodeChartQuotientIdeal R I q hq hI))))) := by
  refine isIso_c_app_top_of_bijective_globalSectionsHom _ _ ?_
  rw [globalSectionsHom_nodeChartQuotientHom]
  exact (ConcreteCategory.isIso_iff_bijective _).mp inferInstance

end Instances

/-! ### The headline over the canonical comparison -/

/-- **`hnode` from one isomorphism at a canonical morphism.** Over a principal base ideal generated
by a non-zero-divisor, `T_inv/⟨σ⟩` is a formal scheme as soon as its restriction to the node
chart's open is carried isomorphically onto the formal spectrum of its own sections by
`AlgebraicGeometry.nodeChartQuotientHom`.

This is `AlgebraicGeometry.exists_formalScheme_of_isIso_desc_nodeChartAdicHom` with hypothesis 4
traded across `AlgebraicGeometry.isIso_desc_nodeChartAdicHom_iff`, so nothing is given up: the two
hypotheses are equivalent. What is bought is that the hypothesis is now an isomorphism at a
morphism out of an open of the quotient, which is what
`AlgebraicGeometry.exists_formalScheme_of_iso_restrict_tateInvNodeChartQuotientOpens` asks for as a
bare `Nonempty` of an isomorphism, here with the isomorphism named.

**It does not decide `hnode`.** The isomorphism is a hypothesis; no declaration on this tree
produces one, and refuting it refutes neither `hnode` nor the existential form. -/
theorem exists_formalScheme_of_isIso_nodeChartQuotientHom (t : R) (ht : I = Ideal.span {t})
    (hreg : IsLeftRegular t)
    (he :
      letI : TopologicalSpace ((actionQuotient (tateInvPeriodAction R I q hq hI)).presheaf.obj
          (op (tateInvNodeChartQuotientOpens R I q hq hI))) :=
        (tateInvNodeChartQuotientIdeal R I q hq hI).adicTopology
      haveI : IsAdicRing (tateInvNodeChartQuotientIdeal R I q hq hI) :=
        isAdicRing_tateInvNodeChartQuotientIdeal_of_isLeftRegular_base R I q hq hI t ht hreg
      IsIso (nodeChartQuotientHom R I q hq hI
        (fg_tateInvNodeChartQuotientIdeal_of_isLeftRegular_base R I q hq hI t ht hreg)
        (adicSectionsLocallyFG_nodeChartPsi R I q hq hI t ht hreg))) :
    ∃ X : FormalScheme.{u},
      X.toLocallyRingedSpace = actionQuotient (tateInvPeriodAction R I q hq hI) := by
  letI : TopologicalSpace ((actionQuotient (tateInvPeriodAction R I q hq hI)).presheaf.obj
      (op (tateInvNodeChartQuotientOpens R I q hq hI))) :=
    (tateInvNodeChartQuotientIdeal R I q hq hI).adicTopology
  haveI : IsAdicRing (tateInvNodeChartQuotientIdeal R I q hq hI) :=
    isAdicRing_tateInvNodeChartQuotientIdeal_of_isLeftRegular_base R I q hq hI t ht hreg
  exact exists_formalScheme_of_isIso_desc_nodeChartAdicHom R I q hq hI t ht hreg
    ((isIso_desc_nodeChartAdicHom_iff R I q hq hI _ _).mpr he)

end AlgebraicGeometry

